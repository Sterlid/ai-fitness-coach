# These values are safe to expose in an Expo client when Row Level Security is enabled.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional for a fixed deployment URL. When omitted, the current browser origin is used.
EXPO_PUBLIC_AUTH_REDIRECT_URL=
